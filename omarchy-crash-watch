#!/bin/bash

# omarchy:summary=Watch for process crashes and announce on status bar
# omarchy:hidden=true

set -uo pipefail

readonly COREDUMP_MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1
readonly CRASH_GLYPH=$'\U000f16a1'
readonly dedupe_seconds=${OMARCHY_CRASH_DEDUPE_SECONDS:-60}
readonly ignore_pattern=${OMARCHY_CRASH_IGNORE:-}

declare -A last_notified

announce() {
  local comm=$1 pid=$2 exe=$3 signal=$4

  # Wait for shell to be up
  omarchy-notification-wait 5 >/dev/null 2>&1 || true

  # Record crash and notify status bar widget on the left
  if command -v omarchy-crash-manager >/dev/null 2>&1; then
    omarchy-crash-manager add "$comm" "$pid" "$exe" "$signal"
  elif [[ -x "$HOME/.config/omarchy/plugins/omarchy-crashes/crash-manager" ]]; then
    "$HOME/.config/omarchy/plugins/omarchy-crashes/crash-manager" add "$comm" "$pid" "$exe" "$signal"
  fi
}

# -n 0 so a restart does not re-announce crashes already dealt with.
journalctl -f -n 0 -o json "MESSAGE_ID=$COREDUMP_MESSAGE_ID" 2>/dev/null |
  while IFS= read -r entry; do
    IFS=$'\t' read -r uid comm pid exe signal < <(
      jq -r '[(._UID // "-"),
              (.COREDUMP_COMM // "-"),
              (.COREDUMP_PID // "-"),
              (.COREDUMP_EXE // "-"),
              (.COREDUMP_SIGNAL_NAME // "-")] | @tsv' <<<"$entry" 2>/dev/null
    )

    [[ $pid =~ ^[0-9]+$ ]] || continue

    # Checked per crash, not at startup
    [[ -n $(omarchy-default-agent) ]] || continue

    # Only this user's crashes
    [[ $uid =~ ^[0-9]+$ ]] || continue
    ((uid == UID)) || continue

    # Prefer executable basename
    name=$comm
    [[ $exe == /* ]] && name=${exe##*/}

    [[ -n $ignore_pattern && $name =~ $ignore_pattern ]] && continue

    # Never announce our own machinery
    [[ $name == omarchy-crash-* || $name == omarchy-agent-* ]] && continue

    now=$EPOCHSECONDS
    (((now - ${last_notified[$name]:-0}) < dedupe_seconds)) && continue

    announce "$name" "$pid" "$exe" "$signal" && last_notified[$name]=$now
  done
