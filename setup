#!/bin/bash
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$HOME/.local/bin"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
DROPIN_DIR="$SYSTEMD_USER_DIR/omarchy-crash-watch.service.d"
DROPIN_FILE="$DROPIN_DIR/crashbar.conf"
LEGACY_SERVICE_FILE="$SYSTEMD_USER_DIR/omarchy-crash-watch.service"
BACKUP_SERVICE="$SYSTEMD_USER_DIR/omarchy-crash-watch.service.backup"
WRAPPER_BIN="$BIN_DIR/omarchy-crash-watch"

mkdir -p "$BIN_DIR" "$DROPIN_DIR"

chmod +x "$PLUGIN_DIR/crashbar" "$PLUGIN_DIR/omarchy-crash-watch" "$PLUGIN_DIR/setup" "$PLUGIN_DIR/install.sh"
if [[ -f "$PLUGIN_DIR/uninstall.sh" ]]; then
  chmod +x "$PLUGIN_DIR/uninstall.sh"
fi

# Clean up any stale backups of Crashbar's own files
for b in "$BIN_DIR/omarchy-crash-watch.backup" "$BIN_DIR/crashbar.backup" "$BIN_DIR/omarchy-crashbar.backup" "$BACKUP_SERVICE"; do
  if [[ -f "$b" ]] && grep -qE "Managed by Crashbar|crashbar|omarchy-crashbar|on status bar" "$b" 2>/dev/null; then
    rm -f "$b"
  fi
done

# 1. Install CLI symlinks while safely preserving genuine third-party binaries
for bin_name in crashbar omarchy-crashbar; do
  target="$BIN_DIR/$bin_name"
  if [[ -e "$target" || -L "$target" ]]; then
    if [[ "$(readlink -f "$target" 2>/dev/null || true)" != "$PLUGIN_DIR/crashbar" ]]; then
      if ! grep -qE "Managed by Crashbar|crashbar|omarchy-crashbar" "$target" 2>/dev/null; then
        echo "Preserving existing $target to $target.backup"
        cp -p "$target" "$target.backup"
      fi
    fi
  fi
  ln -sf "$PLUGIN_DIR/crashbar" "$target"
done

# 2. Clean up any legacy full service unit override from earlier versions, preserving genuine user configs
if [[ -f "$LEGACY_SERVICE_FILE" ]]; then
  if grep -qE "Managed by Crashbar|on status bar|%h/\.local/bin/omarchy-crash-watch" "$LEGACY_SERVICE_FILE" 2>/dev/null; then
    rm -f "$LEGACY_SERVICE_FILE"
  fi
fi

# 3. Install robust self-healing wrapper script into ~/.local/bin/omarchy-crash-watch
if [[ -e "$WRAPPER_BIN" || -L "$WRAPPER_BIN" ]]; then
  if [[ -f "$WRAPPER_BIN" ]] && ! grep -qE "Managed by Crashbar|crashbar|omarchy-crashbar" "$WRAPPER_BIN" 2>/dev/null; then
    echo "Preserving existing $WRAPPER_BIN to $WRAPPER_BIN.backup"
    cp -p "$WRAPPER_BIN" "$WRAPPER_BIN.backup"
  fi
fi

cat > "$WRAPPER_BIN" <<'WRAPPER_EOF'
#!/bin/bash
# Managed by Crashbar
set -uo pipefail

PLUGIN_DIR="${HOME}/.config/omarchy/plugins/omarchy-crashbar"
DROPIN_FILE="${HOME}/.config/systemd/user/omarchy-crash-watch.service.d/crashbar.conf"
DROPIN_DIR="${HOME}/.config/systemd/user/omarchy-crash-watch.service.d"
LEGACY_SERVICE_FILE="${HOME}/.config/systemd/user/omarchy-crash-watch.service"
BACKUP_SERVICE="${HOME}/.config/systemd/user/omarchy-crash-watch.service.backup"

restore_stock() {
  # 1. Remove systemd drop-in override
  rm -f "$DROPIN_FILE"
  rmdir "$DROPIN_DIR" 2>/dev/null || true

  # 2. If a legacy Crashbar unit file was present, clean it up or restore true backup
  if [[ -f "$LEGACY_SERVICE_FILE" ]]; then
    if grep -qE "Managed by Crashbar|on status bar|%h/\.local/bin/omarchy-crash-watch" "$LEGACY_SERVICE_FILE" 2>/dev/null; then
      if [[ -f "$BACKUP_SERVICE" ]] && ! grep -qE "Managed by Crashbar|on status bar|%h/\.local/bin/omarchy-crash-watch" "$BACKUP_SERVICE" 2>/dev/null; then
        mv -f "$BACKUP_SERVICE" "$LEGACY_SERVICE_FILE"
      else
        rm -f "$LEGACY_SERVICE_FILE"
      fi
    fi
  fi
  rm -f "$BACKUP_SERVICE" 2>/dev/null || true

  # 3. Clean up CLI symlinks and restore backups if genuine
  for name in crashbar omarchy-crashbar; do
    target="$HOME/.local/bin/$name"
    if [[ -L "$target" ]] && [[ "$(readlink "$target" 2>/dev/null)" == *omarchy-crashbar* ]]; then
      rm -f "$target"
    fi
    if [[ -f "$HOME/.local/bin/$name.backup" ]]; then
      if grep -qE "Managed by Crashbar|crashbar|omarchy-crashbar" "$HOME/.local/bin/$name.backup" 2>/dev/null; then
        rm -f "$HOME/.local/bin/$name.backup"
      else
        mv -f "$HOME/.local/bin/$name.backup" "$target"
      fi
    fi
  done

  # 4. Clean up this wrapper and restore original omarchy-crash-watch if genuine
  rm -f "$HOME/.local/bin/omarchy-crash-watch"
  if [[ -f "$HOME/.local/bin/omarchy-crash-watch.backup" ]]; then
    if grep -qE "Managed by Crashbar|crashbar|omarchy-crashbar" "$HOME/.local/bin/omarchy-crash-watch.backup" 2>/dev/null; then
      rm -f "$HOME/.local/bin/omarchy-crash-watch.backup"
    else
      mv -f "$HOME/.local/bin/omarchy-crash-watch.backup" "$HOME/.local/bin/omarchy-crash-watch"
    fi
  fi

  systemctl --user daemon-reload >/dev/null 2>&1 || true
}

if [[ "${1:-}" == "--restore" ]]; then
  restore_stock
  exit 0
fi

# If Crashbar is installed, delegate to plugin
if [[ -f "$PLUGIN_DIR/manifest.json" && -x "$PLUGIN_DIR/omarchy-crash-watch" ]]; then
  exec "$PLUGIN_DIR/omarchy-crash-watch" "$@"
fi

# Crashbar was uninstalled/removed: restore stock configuration and launch original watcher
restore_stock
if [[ -x /usr/bin/omarchy-crash-watch ]]; then
  exec /usr/bin/omarchy-crash-watch "$@"
fi
WRAPPER_EOF

chmod +x "$WRAPPER_BIN"

# 4. Configure systemd user drop-in override (leaves stock unit untouched)
cat > "$DROPIN_FILE" <<'UNIT_EOF'
# Managed by Crashbar
[Service]
ExecStart=
ExecStart=%h/.local/bin/omarchy-crash-watch
UNIT_EOF

systemctl --user daemon-reload >/dev/null 2>&1 || true
systemctl --user restart omarchy-crash-watch.service >/dev/null 2>&1 || true
