#!/bin/bash
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$HOME/.local/bin"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"

mkdir -p "$BIN_DIR" "$SYSTEMD_USER_DIR"

chmod +x "$PLUGIN_DIR/crash-manager" "$PLUGIN_DIR/omarchy-crash-watch"

ln -sf "$PLUGIN_DIR/crash-manager" "$BIN_DIR/omarchy-crash-manager"
ln -sf "$PLUGIN_DIR/omarchy-crash-watch" "$BIN_DIR/omarchy-crash-watch"

cat > "$SYSTEMD_USER_DIR/omarchy-crash-watch.service" <<UNIT
[Unit]
Description=Announce process crashes on status bar and offer an AI diagnosis
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=!%h/.local/state/omarchy/toggles/crash-capture-off

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-crash-watch
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
UNIT

systemctl --user daemon-reload >/dev/null 2>&1 || true
systemctl --user restart omarchy-crash-watch.service >/dev/null 2>&1 || true
