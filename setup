#!/bin/bash
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$HOME/.local/bin"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
DROPIN_DIR="$SYSTEMD_USER_DIR/omarchy-crash-watch.service.d"
DROPIN_FILE="$DROPIN_DIR/crashbar.conf"
LEGACY_SERVICE_FILE="$SYSTEMD_USER_DIR/omarchy-crash-watch.service"
LEGACY_SERVICE_BACKUP="$LEGACY_SERVICE_FILE.omarchy-crashbar-backup"
WRAPPER_BIN="$BIN_DIR/omarchy-crash-watch"
WRAPPER_BACKUP="$WRAPPER_BIN.omarchy-crashbar-backup"

readonly CRASHBAR_SIGNATURE="OMARCHY_CRASHBAR_MANAGED_FILE_v1"

# Fast-path: if already set up and configured, exit immediately with zero side-effects
if [[ "${1:-}" != "--force" ]] && [[ -f "$DROPIN_FILE" && -x "$WRAPPER_BIN" && -L "$BIN_DIR/crashbar" ]]; then
  exit 0
fi

mkdir -p "$BIN_DIR" "$DROPIN_DIR"

chmod +x "$PLUGIN_DIR/crashbar" "$PLUGIN_DIR/omarchy-crash-watch" "$PLUGIN_DIR/setup" "$PLUGIN_DIR/install.sh"
if [[ -f "$PLUGIN_DIR/uninstall.sh" ]]; then
  chmod +x "$PLUGIN_DIR/uninstall.sh"
fi

# 1. Safely install CLI symlinks, preserving any existing user files with dedicated backup extension
for bin_name in crashbar omarchy-crashbar; do
  target="$BIN_DIR/$bin_name"
  target_backup="$target.omarchy-crashbar-backup"
  if [[ -e "$target" || -L "$target" ]]; then
    # If it's already a symlink pointing to this plugin's crashbar, leave it
    if [[ "$(readlink -f "$target" 2>/dev/null || true)" != "$PLUGIN_DIR/crashbar" ]]; then
      echo "Preserving existing $target to $target_backup"
      cp -p "$target" "$target_backup"
    fi
  fi
  ln -sf "$PLUGIN_DIR/crashbar" "$target"
done

# 2. Preserve any existing ~/.config/systemd/user/omarchy-crash-watch.service
if [[ -f "$LEGACY_SERVICE_FILE" ]]; then
  if grep -qF "$CRASHBAR_SIGNATURE" "$LEGACY_SERVICE_FILE" 2>/dev/null; then
    # Previously created by Crashbar; safe to clean up in favor of drop-in
    rm -f "$LEGACY_SERVICE_FILE"
  else
    # User's own service file: safely back it up before moving aside
    if [[ ! -f "$LEGACY_SERVICE_BACKUP" ]]; then
      echo "Preserving existing user $LEGACY_SERVICE_FILE to $LEGACY_SERVICE_BACKUP"
      cp -p "$LEGACY_SERVICE_FILE" "$LEGACY_SERVICE_BACKUP"
    fi
    rm -f "$LEGACY_SERVICE_FILE"
  fi
fi

# 3. Safely install wrapper into ~/.local/bin/omarchy-crash-watch
if [[ -e "$WRAPPER_BIN" || -L "$WRAPPER_BIN" ]]; then
  if ! grep -qF "$CRASHBAR_SIGNATURE" "$WRAPPER_BIN" 2>/dev/null; then
    if [[ ! -f "$WRAPPER_BACKUP" ]]; then
      echo "Preserving existing user $WRAPPER_BIN to $WRAPPER_BACKUP"
      cp -p "$WRAPPER_BIN" "$WRAPPER_BACKUP"
    fi
  fi
fi

cat > "$WRAPPER_BIN" <<'WRAPPER_EOF'
#!/bin/bash
# OMARCHY_CRASHBAR_MANAGED_FILE_v1
set -uo pipefail

PLUGIN_DIR="${HOME}/.config/omarchy/plugins/omarchy-crashbar"
DROPIN_FILE="${HOME}/.config/systemd/user/omarchy-crash-watch.service.d/crashbar.conf"
DROPIN_DIR="${HOME}/.config/systemd/user/omarchy-crash-watch.service.d"
LEGACY_SERVICE_BACKUP="${HOME}/.config/systemd/user/omarchy-crash-watch.service.omarchy-crashbar-backup"
LEGACY_SERVICE_FILE="${HOME}/.config/systemd/user/omarchy-crash-watch.service"
WRAPPER_BIN="${HOME}/.local/bin/omarchy-crash-watch"
WRAPPER_BACKUP="${WRAPPER_BIN}.omarchy-crashbar-backup"

readonly CRASHBAR_SIGNATURE="OMARCHY_CRASHBAR_MANAGED_FILE_v1"

restore_stock() {
  # 1. Remove systemd drop-in override
  rm -f "$DROPIN_FILE"
  rmdir "$DROPIN_DIR" 2>/dev/null || true

  # 2. Restore user's original service file if backed up
  if [[ -f "$LEGACY_SERVICE_BACKUP" ]]; then
    mv -f "$LEGACY_SERVICE_BACKUP" "$LEGACY_SERVICE_FILE"
  elif [[ -f "$LEGACY_SERVICE_FILE" ]] && grep -qF "$CRASHBAR_SIGNATURE" "$LEGACY_SERVICE_FILE" 2>/dev/null; then
    rm -f "$LEGACY_SERVICE_FILE"
  fi

  # 3. Clean up CLI symlinks and restore user backups if present
  for name in crashbar omarchy-crashbar; do
    target="${HOME}/.local/bin/${name}"
    target_backup="${target}.omarchy-crashbar-backup"
    if [[ -L "$target" ]] && [[ "$(readlink "$target" 2>/dev/null)" == *omarchy-crashbar* ]]; then
      rm -f "$target"
    fi
    if [[ -f "$target_backup" ]]; then
      mv -f "$target_backup" "$target"
    fi
  done

  # 4. Remove this wrapper and restore user's original omarchy-crash-watch if backed up
  rm -f "$WRAPPER_BIN"
  if [[ -f "$WRAPPER_BACKUP" ]]; then
    mv -f "$WRAPPER_BACKUP" "$WRAPPER_BIN"
  fi

  systemctl --user daemon-reload >/dev/null 2>&1 || true
}

if [[ "${1:-}" == "--restore" ]]; then
  restore_stock
  exit 0
fi

# If Crashbar is installed, delegate to plugin
if [[ -f "$PLUGIN_DIR/manifest.json" && -x "$PLUGIN_DIR/omarchy-crash-watch" ]]; then
  exec "$PLUGIN_DIR/omarchy-crash-watch" "$@"
fi

# Crashbar was uninstalled/removed: restore stock configuration and launch original watcher
restore_stock
if [[ -x /usr/bin/omarchy-crash-watch ]]; then
  exec /usr/bin/omarchy-crash-watch "$@"
fi
WRAPPER_EOF

chmod +x "$WRAPPER_BIN"

# 4. Configure systemd user drop-in override (leaves stock unit untouched)
cat > "$DROPIN_FILE" <<'UNIT_EOF'
# OMARCHY_CRASHBAR_MANAGED_FILE_v1
[Service]
ExecStart=
ExecStart=%h/.local/bin/omarchy-crash-watch
UNIT_EOF

systemctl --user daemon-reload >/dev/null 2>&1 || true
systemctl --user restart omarchy-crash-watch.service >/dev/null 2>&1 || true
